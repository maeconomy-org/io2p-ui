# Deployment Environment Variables
# Copy this file to .env and configure for your VM

# REQUIRED VARIABLES (must be configured)
# =============================================================================

# Container Configuration
GH_ORG=maeconomy-org
CONTAINER_NAME=iom-ui
IMAGE_NAME=iom-ui
NODE_ENV=production
IMAGE_TAG=latest

# Host port published on 127.0.0.1 — nginx upstream points at this.
# Use a unique value per stack when running multiple UIs on one VM
# (e.g. 3000 for dev, 3001 for prod). The container port is always 3000.
EXTERNAL_PORT=3000

# Base URL for all API services (REQUIRED - different per VM)
# The SDK derives service paths automatically:
#   auth:     ${BASE_URL}/auth
#   registry: ${BASE_URL}/registrar
#   node:     ${BASE_URL}/node-network
BASE_URL="https://example.com"

# Optional: mTLS certificate port (default: 553)
# CERT_PORT=553

# HERE Maps API Key (REQUIRED for map features)
HERE_API_KEY=your-here-api-key

# Redis Configuration (REQUIRED for Docker Compose)
REDIS_PASSWORD=your-secure-redis-password

# =============================================================================
# OPTIONAL VARIABLES (with sensible defaults)
# =============================================================================

# Per-service URL overrides (only if services live on different hosts)
# AUTH_BASE_URL="https://auth.example.com"
# REGISTRY_BASE_URL="https://registry.example.com"
# NODE_BASE_URL="https://node.example.com"

# Per-service timeout overrides in ms (default: 30000)
# AUTH_TIMEOUT=30000
# REGISTRY_TIMEOUT=30000
# NODE_TIMEOUT=30000

# App Branding (override for white-label deployments)
# APP_NAME="Internet of Materials"
# APP_DESCRIPTION="Material Management System"
# APP_ACRONYM="IoM"
# CONTACT_URL="https://example.com/contact"
# SUPPORT_EMAIL="support@maeconomy.org"

# Logging (simplified)
# LOG_LEVEL=info                      # debug, info, warn, error

# Sentry Configuration (GDPR compliant - use EU region)
# SENTRY_RELEASE is auto-detected from the app version baked into the Docker image
# Only set explicitly to override (e.g. for canary deployments)
SENTRY_DSN=https://your-key@o123.ingest.de.sentry.io/456
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=your-project-name
SENTRY_ENABLED=false
# SENTRY_RELEASE=1.0.12  # Only needed to override auto-detected version
