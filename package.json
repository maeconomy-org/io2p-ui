{
  "private": true,
  "name": "iom-ui",
  "version": "1.1.12",
  "description": "IoM UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/maeconomy-org/iom-ui.git"
  },
  "author": "ReCheck B.V.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "node e2e/fixtures/generate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true next build",
    "typecheck": "tsc --noEmit",
    "fullcheck": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:run && pnpm run build",
    "prepare": "husky"
  },
