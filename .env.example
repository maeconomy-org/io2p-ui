# UI Local Development Environment Variables
# Copy this file to .env.local for local development
# All variables are runtime-configurable (no rebuild needed)

# =============================================================================
# REQUIRED VARIABLES (must be configured)
# =============================================================================

# Environment Configuration
NODE_ENV="development"
EMAIL_LOGIN_ENABLED="false"

# Base URL for all API services (REQUIRED)
# The SDK derives service paths automatically:
#   auth:     ${BASE_URL}/auth
#   registry: ${BASE_URL}/registrar
#   node:     ${BASE_URL}/node-network
BASE_URL="https://example.com"

# Optional: mTLS certificate port (default: 553)
# CERT_PORT=553

# HERE Maps API Key (REQUIRED for map features)
HERE_API_KEY=your-here-api-key

# Redis (REQUIRED — backs the telemetry ingest rate limiter)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=your-secure-redis-password

# =============================================================================
# io2p-v2 BACKEND (new stack — REQUIRED for auth + data)
# =============================================================================

# better-auth issuer origin (io2p-auth). The UI's auth client points here and
# mints the short-lived JWT from it; the client appends /api/auth.
# Local dev: http://localhost:8081
AUTH_BASE_URL="http://localhost:8081"

# io2p-core storage-node origin, consumed by io2p-client (it appends /api/v1).
# Local dev: http://localhost:8080
CORE_BASE_URL="http://localhost:8080"

# =============================================================================
# OPTIONAL VARIABLES (with sensible defaults)
# =============================================================================

# Per-service URL overrides (legacy iom-sdk; AUTH_BASE_URL is set above)
# REGISTRY_BASE_URL="https://registry.example.com"
# NODE_BASE_URL="https://node.example.com"

# Per-service timeout overrides in ms (default: 30000)
# AUTH_TIMEOUT=30000
# REGISTRY_TIMEOUT=30000
# NODE_TIMEOUT=30000

# App Branding (override for white-label deployments)
# APP_NAME="Internet of Materials"
# APP_DESCRIPTION="Material Management System"
# APP_ACRONYM="IoM"
# CONTACT_URL="https://example.com/contact"
# SUPPORT_EMAIL="support@maeconomy.org"

# Logging
# LOG_LEVEL gates the server NDJSON stream AND the browser console outside
# production (in production the browser console is off by design; the
# localStorage['iom:log-level'] override re-enables it on a live session).
LOG_LEVEL=debug                       # debug, info, warn, error
# Minimum level the browser ships to /api/telemetry. Default: info in
# production, off in dev. 'off' disables shipping everywhere.
# LOG_SHIP_LEVEL=info

# Observability / OpenTelemetry (server only; all optional)
# Master switch. Off means NO OTel machinery boots at all — NDJSON logging is
# unaffected, so this is safe to leave unset in development.
# OTEL_ENABLED=false
# Collector coupling. When the endpoint is set, /api/telemetry also forwards
# browser records to it as OTLP logs (the ingest key stays server-side).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=api-key=xxx,other=yyy
# Resource attributes. Without these everything reports as "unknown" and you
# cannot tell one release or environment from another in the backend.
# APP_VERSION=1.2.3
# DEPLOYMENT_ENVIRONMENT=production
# SERVICE_NAMESPACE=iom

# How many proxies in front of this app append to x-forwarded-for. Rate limits
# key on the address this picks, so both directions fail: too low and every
# client behind the outermost proxy shares ONE bucket, too high and you key on
# a spoofable client-supplied entry. 1 = a single trusted proxy (default).
# TRUSTED_PROXY_HOPS=1

# File / Import limits (all optional; defaults shown)
# Import path parses xlsx/csv into memory, so the cap is conservative.
# MAX_IMPORT_FILE_SIZE_MB=100
# MAX_IMPORT_PAYLOAD_MB=100
# MAX_OBJECTS_PER_IMPORT=50000
# Attachment uploads stream through S3 in 8 MB parts (max 128 parts).
# 1 GB is the hard ceiling from that math; keep below to leave headroom.
# MAX_ATTACHMENT_SIZE_MB=1024

# Sentry Configuration (optional for development)
# SENTRY_DSN=https://your-key@o123.ingest.de.sentry.io/456
# SENTRY_ORG=your-organization-slug
# SENTRY_PROJECT=your-project-name-dev
# SENTRY_ENABLED=false
# SENTRY_RELEASE=dev
# SENTRY_AUTH_TOKEN=sntrys_xxx   # Organization Auth Token from https://recheck-io.sentry.io/settings/auth-tokens/
