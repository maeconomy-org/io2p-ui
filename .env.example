# UI Local Development Environment Variables
# Copy this file to .env.local for local development
# All variables are runtime-configurable (no rebuild needed)

# =============================================================================
# REQUIRED VARIABLES (must be configured)
# =============================================================================

# Environment Configuration
NODE_ENV="development"
EMAIL_LOGIN_ENABLED="false"

# Base URL for all API services (REQUIRED)
# The SDK derives service paths automatically:
#   auth:     ${BASE_URL}/auth
#   registry: ${BASE_URL}/registrar
#   node:     ${BASE_URL}/node-network
BASE_URL="https://example.com"

# Optional: mTLS certificate port (default: 553)
# CERT_PORT=553

# HERE Maps API Key (REQUIRED for map features)
HERE_API_KEY=your-here-api-key

# Redis Configuration (REQUIRED - use local Redis)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=your-secure-redis-password

# =============================================================================
# OPTIONAL VARIABLES (with sensible defaults)
# =============================================================================

# Per-service URL overrides (only if services live on different hosts)
# AUTH_BASE_URL="https://auth.example.com"
# REGISTRY_BASE_URL="https://registry.example.com"
# NODE_BASE_URL="https://node.example.com"

# Per-service timeout overrides in ms (default: 30000)
# AUTH_TIMEOUT=30000
# REGISTRY_TIMEOUT=30000
# NODE_TIMEOUT=30000

# App Branding (override for white-label deployments)
# APP_NAME="Internet of Materials"
# APP_DESCRIPTION="Material Management System"
# APP_ACRONYM="IoM"
# CONTACT_URL="https://example.com/contact"
# SUPPORT_EMAIL="support@maeconomy.org"

# Logging (simplified - only LOG_LEVEL needed)
LOG_LEVEL=debug                       # debug, info, warn, error

# Sentry Configuration (optional for development)
# SENTRY_DSN=https://your-key@o123.ingest.de.sentry.io/456
# SENTRY_ORG=your-organization-slug
# SENTRY_PROJECT=your-project-name-dev
# SENTRY_ENABLED=false
# SENTRY_RELEASE=dev
# SENTRY_AUTH_TOKEN=sntrys_xxx   # Organization Auth Token from https://recheck-io.sentry.io/settings/auth-tokens/
